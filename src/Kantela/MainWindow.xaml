<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Kantela.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kantela.Core.ViewModels"
    xmlns:controls="using:Kantela.Controls"
    xmlns:views="using:Kantela.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Kantela">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Loaded="Root_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="560" MinWidth="400" MaxWidth="1000" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right">
            <AppBarButton Icon="Add" Label="Add" Command="{x:Bind ViewModel.AddCommand}" />
            <AppBarSeparator />
            <AppBarButton Icon="OpenFile" Label="Import">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="JSON..." Command="{x:Bind ViewModel.ImportJsonCommand}" />
                        <MenuFlyoutItem Text="OPML..." Command="{x:Bind ViewModel.ImportOpmlCommand}" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Save" Label="Export">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="JSON..." Command="{x:Bind ViewModel.ExportJsonCommand}" />
                        <MenuFlyoutItem Text="OPML..." Command="{x:Bind ViewModel.ExportOpmlCommand}" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Folder" Label="Open data folder" Click="OpenDataFolder_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Column widths and padding must match the item template and ItemContainerStyle below. -->
            <Grid Padding="12,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="112" />
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style x:Key="SortHeaderButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0,6" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </Grid.Resources>
                <Button Tag="Added" Style="{StaticResource SortHeaderButtonStyle}" Click="SortHeader_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="#" />
                        <FontIcon x:Name="AddedSortIcon" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Tag="Title" Style="{StaticResource SortHeaderButtonStyle}" Click="SortHeader_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Name" />
                        <FontIcon x:Name="TitleSortIcon" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Tag="Previewed" Style="{StaticResource SortHeaderButtonStyle}" Click="SortHeader_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Previewed" />
                        <FontIcon x:Name="PreviewedSortIcon" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Tag="Visited" Style="{StaticResource SortHeaderButtonStyle}" Click="SortHeader_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Visited" />
                        <FontIcon x:Name="VisitedSortIcon" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>

            <ListView
                x:Name="SitesListView"
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Sites}"
                SelectionMode="Single"
                SelectionChanged="Sites_SelectionChanged"
                DoubleTapped="Sites_DoubleTapped"
                KeyDown="Sites_KeyDown">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SiteItemViewModel">
                        <Grid Padding="0,8" ColumnSpacing="12" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Open in browser" Icon="Globe" Click="OpenMenuItem_Click" />
                                    <MenuFlyoutItem Text="Edit" Icon="Edit" Click="EditMenuItem_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Delete" Icon="Delete" Click="DeleteMenuItem_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind Number, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid Grid.Column="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:SiteIconView VerticalAlignment="Center" Icon="{x:Bind Icon, Mode=OneWay}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Text="{x:Bind DisplayName, Mode=OneWay}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind Url, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="{x:Bind LastPreviewedText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Text="{x:Bind LastVisitedText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <controls:ColumnSplitter
            Grid.Column="1"
            Grid.RowSpan="2"
            Width="6"
            Background="Transparent">
            <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </controls:ColumnSplitter>

        <Grid Grid.Column="2" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="PreviewHeader"
                Padding="12,8"
                ColumnSpacing="12"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="PreviewTitle"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="Preview only. The page cannot be operated; click it to open in your browser."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Click="OpenSelected_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Globe" />
                        <TextBlock Text="Open in browser" />
                    </StackPanel>
                </Button>
            </Grid>

            <views:SitePreview
                x:Name="Preview"
                Grid.Row="1"
                PageLoaded="Preview_PageLoaded"
                Clicked="Preview_Clicked" />
        </Grid>
    </Grid>
</Window>
