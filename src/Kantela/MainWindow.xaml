<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Kantela.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kantela.Core.ViewModels"
    xmlns:controls="using:Kantela.Controls"
    xmlns:views="using:Kantela.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Kantela">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Loaded="Root_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" MinWidth="280" MaxWidth="800" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right">
            <AppBarButton Icon="Add" Label="Add" Command="{x:Bind ViewModel.AddCommand}" />
            <AppBarSeparator />
            <AppBarButton Icon="OpenFile" Label="Import">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="JSON..." Command="{x:Bind ViewModel.ImportJsonCommand}" />
                        <MenuFlyoutItem Text="OPML..." Command="{x:Bind ViewModel.ImportOpmlCommand}" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Save" Label="Export">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="JSON..." Command="{x:Bind ViewModel.ExportJsonCommand}" />
                        <MenuFlyoutItem Text="OPML..." Command="{x:Bind ViewModel.ExportOpmlCommand}" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Folder" Label="Open data folder" Click="OpenDataFolder_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <ListView
            x:Name="SitesListView"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Sites}"
            SelectionMode="Single"
            SelectionChanged="Sites_SelectionChanged"
            DoubleTapped="Sites_DoubleTapped"
            KeyDown="Sites_KeyDown"
            CanDragItems="True"
            CanReorderItems="True"
            AllowDrop="True"
            DragItemsCompleted="Sites_DragItemsCompleted">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SiteItemViewModel">
                    <Grid Padding="0,8" ColumnSpacing="12" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Open in browser" Icon="Globe" Click="OpenMenuItem_Click" />
                                <MenuFlyoutItem Text="Edit" Icon="Edit" Click="EditMenuItem_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Delete" Icon="Delete" Click="DeleteMenuItem_Click" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <StackPanel>
                            <TextBlock
                                Text="{x:Bind Title, Mode=OneWay}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Url, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Right"
                                Text="{x:Bind LastVisitedText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Text="{x:Bind LastPreviewedText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <controls:ColumnSplitter
            Grid.Column="1"
            Grid.RowSpan="2"
            Width="6"
            Background="Transparent">
            <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </controls:ColumnSplitter>

        <Grid Grid.Column="2" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="PreviewHeader"
                Padding="12,8"
                ColumnSpacing="12"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="PreviewTitle"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="Preview only. The page cannot be operated; click it to open in your browser."
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Click="OpenSelected_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Globe" />
                        <TextBlock Text="Open in browser" />
                    </StackPanel>
                </Button>
            </Grid>

            <views:SitePreview
                x:Name="Preview"
                Grid.Row="1"
                PageLoaded="Preview_PageLoaded"
                Clicked="Preview_Clicked" />
        </Grid>
    </Grid>
</Window>
